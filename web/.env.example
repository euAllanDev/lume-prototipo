# Application requests use a pooled PostgreSQL/Neon URL.
DATABASE_URL=

# Migrations and administration use a direct, non-pooled PostgreSQL/Neon URL.
DATABASE_URL_UNPOOLED=

# Better Auth server-only configuration. Generate a random secret with at least 32 bytes.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Development: Mailpit SMTP. Production: Resend requires RESEND_API_KEY and verified EMAIL_FROM.
EMAIL_FROM=Lume <no-reply@localhost>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
